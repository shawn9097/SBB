# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STANDARD_PRICE_ID=price_...   # $129/mo
STRIPE_VOLUME_PRICE_ID=price_...     # $249/mo
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Twilio (SMS) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...            # The number sequences are sent from

# ─── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Postmark (inbound email / BCC) ────────────────────────────────────────────
POSTMARK_SERVER_API_TOKEN=...
POSTMARK_WEBHOOK_TOKEN=...           # Shared secret to verify inbound webhooks

# ─── Anthropic / Claude (Voice Twin + niche detection) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── App config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
INBOUND_EMAIL_DOMAIN=warmside.app    # Domain used for per-contractor BCC addresses
CRON_SECRET=...                      # Secret to protect /api/cron from public calls
