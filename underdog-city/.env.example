# Email service provider (Beehiiv, ConvertKit, Mailchimp, etc.)
# Must accept { email, double_opt_in } and trigger a double opt-in confirmation email.
ESP_SUBSCRIBE_URL=
ESP_API_KEY=

# ISO date string for the launch countdown, e.g. 2026-09-01T00:00:00Z
# Leave unset to show "Coming soon" instead of a countdown.
NEXT_PUBLIC_LAUNCH_DATE=
