# Beehiiv — create a publication, then Settings → Integrations → API to make a key.
# Publication ID looks like "pub_xxxxxxxxxxxx".
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Canonical site URL, no trailing slash. Drives metadata, OG, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://theunderdogcity.com

# Plausible analytics domain (e.g. underdogcity.com). Leave unset to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ISO date string for the launch countdown, e.g. 2026-09-01T00:00:00Z
# Leave unset to show "Coming soon" instead of a countdown.
NEXT_PUBLIC_LAUNCH_DATE=
