# Email service provider — set ONE of these blocks
# Options: beehiiv | convertkit | mailchimp | (leave blank to log only in dev)
ESP_PROVIDER=

# Beehiiv
BEEHIIV_API_KEY=
BEEHIIV_PUB_ID=

# ConvertKit / Kit
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=   # e.g. us21
